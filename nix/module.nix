# A NixOS module that runs taina as a plain systemd service from a release
# built in Nix, with no container runtime.
#
# Nothing is forced on the host. The database is opt-in: with
# database.createLocally the module runs PostgreSQL 18, creates the database and
# the taina_app role, and generates the env file; otherwise it touches no
# database and points at the PostgreSQL you already run (database.host/port)
# with an environmentFile you provide. No reverse proxy is configured either:
# the app binds bindIp:port and the host's proxy (caddy, cloudflared, ...) sits
# in front, or nothing does.
#
# The app role (taina_app, NOSUPERUSER NOBYPASSRLS) is created by the shared
# release task Taina.Release.bootstrap_db, the same code oka's install path
# calls, so the role and its grants have one source of truth. It runs as a
# oneshot against the postgres superuser over the local socket (peer auth).
#
# Secrets live in an env file outside the store (SECRET_KEY_BASE, the database
# password, DATABASE_URL). When createLocally is on and the operator does not
# supply one, a first-boot oneshot generates it, the same way oka's install.sh
# writes a .env once.
#
# The app runs `Taina.Release.migrate` itself in ExecStartPre before the server
# starts, so updating is `nixos-rebuild switch` and a restart.
{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.services.taina;
  inherit (lib)
    mkIf
    mkOption
    mkEnableOption
    types
    optional
    boolToString
    escapeShellArg
    ;

  dataDir = "/var/lib/taina";
  appRole = "taina_app";

  # The env file the app and the setup oneshots read. When the operator points
  # at their own file, the module never generates or touches it.
  envFile = if cfg.environmentFile != null then cfg.environmentFile else "${dataDir}/taina.env";

  # Generate the env file on first boot only when the database is local (the
  # module is the one that knows the DATABASE_URL then) and the operator did not
  # bring their own.
  generateSecrets = cfg.database.createLocally && cfg.environmentFile == null;

  secretsScript = pkgs.writeShellScript "taina-secrets" ''
    set -eu
    env_file=${escapeShellArg envFile}
    if [ -e "$env_file" ]; then
      echo "taina: $env_file already exists, leaving it alone"
      exit 0
    fi
    secret="$(${pkgs.openssl}/bin/openssl rand -base64 48 | ${pkgs.coreutils}/bin/tr -d '\n')"
    password="$(${pkgs.openssl}/bin/openssl rand -hex 24)"
    umask 077
    ${pkgs.coreutils}/bin/mkdir -p ${escapeShellArg dataDir}
    ${pkgs.coreutils}/bin/cat > "$env_file" <<EOF
# Generated by the taina NixOS module on first boot. Keep it secret: it holds
# the session signing key and the database password. Rotating means deleting it
# and updating the taina_app role password to match.
SECRET_KEY_BASE=$secret
TAINA_APP_PASSWORD=$password
DATABASE_URL=ecto://${appRole}:$password@${cfg.database.host}:${toString cfg.database.port}/${cfg.database.name}
EOF
    ${pkgs.coreutils}/bin/chmod 600 "$env_file"
  '';

in
{
  options.services.taina = {
    enable = mkEnableOption "taina, the community private-cloud server";

    package = mkOption {
      type = types.package;
      default = pkgs.callPackage ./package.nix { };
      defaultText = lib.literalExpression "pkgs.callPackage ./package.nix { }";
      description = "The taina release to run.";
    };

    hostname = mkOption {
      type = types.str;
      example = "nuvem.example.org";
      description = ''
        Public hostname. Drives every URL taina builds (invites, links), so it
        must be the name people reach the box at, TLS included.
      '';
    };

    port = mkOption {
      type = types.port;
      default = 4000;
      description = "Port the process binds. Behind a proxy, this is the internal port.";
    };

    bindIp = mkOption {
      type = types.str;
      default = "127.0.0.1";
      description = ''
        Interface the HTTP listener binds. Loopback by default: a TLS proxy on
        the same box is the only thing that should reach it.
      '';
    };

    urlScheme = mkOption {
      type = types.enum [
        "http"
        "https"
      ];
      default = "https";
      description = ''
        Scheme the app puts in the URLs it builds (invites, links). https by
        default, the case behind a TLS proxy; http when nothing terminates TLS
        in front.
      '';
    };

    urlPort = mkOption {
      type = types.port;
      default = 443;
      description = "Port the app puts in the URLs it builds.";
    };

    environmentFile = mkOption {
      type = types.nullOr types.path;
      default = null;
      example = "/var/lib/taina/taina.env";
      description = ''
        File holding SECRET_KEY_BASE, TAINA_APP_PASSWORD and DATABASE_URL (and
        BACKUP_DATABASE_URL when backups are on), mode 0600. Left null, the
        module generates one at /var/lib/taina/taina.env on first boot when the
        database is local. Required when database.createLocally is false.
      '';
    };

    database = {
      createLocally = mkOption {
        type = types.bool;
        default = false;
        description = ''
          Run PostgreSQL 18 on this host, create the database and the taina_app
          role, and generate the environment file. Off (the default) the module
          touches no database at all: point host/port at a PostgreSQL you
          already run, locally or elsewhere, and bring your own environmentFile.
        '';
      };

      host = mkOption {
        type = types.str;
        default = "127.0.0.1";
        example = "db.example.org";
        description = ''
          Host the app connects to. Written into the generated DATABASE_URL when
          createLocally is on; with an external database the URL in your
          environmentFile wins.
        '';
      };

      port = mkOption {
        type = types.port;
        default = 5432;
        description = "Port the app connects to.";
      };

      name = mkOption {
        type = types.str;
        default = "taina";
        description = "Database name.";
      };
    };

    storageDir = mkOption {
      type = types.path;
      default = "${dataDir}/storage";
      description = "Directory holding Ybira uploads and renditions.";
    };

    backupDir = mkOption {
      type = types.path;
      default = "${dataDir}/backups";
      description = "Directory Nhaman writes scheduled backups to.";
    };

    backup = {
      enable = mkOption {
        type = types.bool;
        default = false;
        description = ''
          Turn on scheduled pg_dump plus storage archives. Needs a working
          BACKUP_DATABASE_URL (superuser) in the environment file, since the app
          role cannot restore objects it does not own.
        '';
      };
    };

    updateCheck = mkOption {
      type = types.bool;
      default = false;
      description = ''
        Let the UI advertise newer taina releases. Off, the box makes no
        outbound call at all.
      '';
    };

    openFirewall = mkOption {
      type = types.bool;
      default = false;
      description = ''
        Open the port in the firewall. Off by default: a TLS proxy sits in
        front, so the only thing that should reach this port is the proxy on the
        loopback interface.
      '';
    };

    settings = mkOption {
      type = types.attrsOf types.str;
      default = { };
      example = { POOL_SIZE = "10"; };
      description = "Extra environment variables for the app, written verbatim.";
    };
  };

  config = mkIf cfg.enable {
    assertions = [
      {
        assertion = cfg.database.createLocally || cfg.environmentFile != null;
        message = "services.taina.environmentFile must be set when database.createLocally is false.";
      }
    ];

    services.postgresql = mkIf cfg.database.createLocally {
      enable = true;
      # taina needs PostgreSQL 18 (RLS features the migrations rely on). NixOS
      # picks the version from stateVersion with mkDefault, so this has to sit
      # above that priority; a host that wants another version can still
      # mkForce its own.
      package = lib.mkOverride 900 pkgs.postgresql_18;
      ensureDatabases = [ cfg.database.name ];
      # The app connects over TCP as taina_app with a password, so loopback
      # needs password auth. Scoped to this database and role so a host that
      # already runs PostgreSQL keeps the rest of its first-match pg_hba rules;
      # the NixOS defaults (peer over the socket, md5 over TCP) still apply
      # underneath.
      authentication = lib.mkBefore ''
        host ${cfg.database.name} ${appRole} 127.0.0.1/32 scram-sha-256
        host ${cfg.database.name} ${appRole} ::1/128 scram-sha-256
      '';
    };

    users.users.taina = {
      isSystemUser = true;
      group = "taina";
      home = dataDir;
      description = "taina community server";
    };
    users.groups.taina = { };

    systemd.tmpfiles.rules = [
      "d '${dataDir}' 0700 taina taina -"
      "d '${cfg.storageDir}' 0700 taina taina -"
      "d '${cfg.backupDir}' 0700 taina taina -"
    ];

    systemd.services.taina-secrets = mkIf generateSecrets {
      description = "taina: generate the environment file on first boot";
      wantedBy = [ "multi-user.target" ];
      before = [ "taina-db-setup.service" "taina.service" ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        ExecStart = secretsScript;
        NoNewPrivileges = true;
      };
    };

    systemd.services.taina-db-setup = mkIf cfg.database.createLocally {
      description = "taina: create the taina_app role and grants";
      wantedBy = [ "multi-user.target" ];
      # postgresql.target pulls in postgresql-setup.service, which is what
      # actually creates the database (services.postgresql.ensureDatabases).
      after = [ "postgresql.target" ] ++ optional generateSecrets "taina-secrets.service";
      requires = [ "postgresql.target" ] ++ optional generateSecrets "taina-secrets.service";
      before = [ "taina.service" ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        # The superuser, over the local socket with peer auth.
        User = "postgres";
        Group = "postgres";
        Environment = [
          "PGHOST=/run/postgresql"
          "PGUSER=postgres"
          "PGDATABASE=${cfg.database.name}"
          "TAINA_APP_ROLE=${appRole}"
        ];
        EnvironmentFile = [ envFile ];
        ExecStart = "${cfg.package}/bin/taina eval 'Taina.Release.bootstrap_db'";
        PrivateTmp = true;
        NoNewPrivileges = true;
      };
    };

    systemd.services.taina = {
      description = "taina community server";
      wantedBy = [ "multi-user.target" ];
      after = [ "network-online.target" ] ++ optional cfg.database.createLocally "postgresql.target";
      wants = [ "network-online.target" ];
      requires =
        optional cfg.database.createLocally "taina-db-setup.service"
        ++ optional generateSecrets "taina-secrets.service";
      # The data directories are often their own mount (a ZFS dataset); wait for
      # them rather than writing to the empty mountpoint on root.
      unitConfig.RequiresMountsFor = [ cfg.storageDir cfg.backupDir ];

      # pg_dump / pg_restore for Nhaman backups.
      path = [ pkgs.postgresql_18 ];

      environment =
        {
          PHX_SERVER = "true";
          PHX_HOST = cfg.hostname;
          PORT = toString cfg.port;
          BIND_IP = cfg.bindIp;
          PHX_URL_SCHEME = cfg.urlScheme;
          PHX_URL_PORT = toString cfg.urlPort;
          STORAGE_ROOT = cfg.storageDir;
          BACKUP_ENABLED = boolToString cfg.backup.enable;
          BACKUP_DIR = cfg.backupDir;
          TAINA_UPDATE_CHECK = boolToString cfg.updateCheck;
        }
        // cfg.settings;

      serviceConfig = {
        Type = "exec";
        User = "taina";
        Group = "taina";
        WorkingDirectory = dataDir;
        EnvironmentFile = [ envFile ];
        # Migrations run as the app role before the server, the same order the
        # release image uses. The role and database exist by now (db-setup).
        ExecStartPre = "${cfg.package}/bin/taina eval 'Taina.Release.migrate'";
        ExecStart = "${cfg.package}/bin/server";
        Restart = "on-failure";
        RestartSec = 5;
        # A clean SIGTERM lets the endpoint drain and in-flight work finish.
        KillSignal = "SIGTERM";
        TimeoutStopSec = 30;
        LimitNOFILE = 65536;

        # Hardening. MemoryDenyWriteExecute is left off: the BEAM's JIT needs
        # writable and executable memory.
        NoNewPrivileges = true;
        PrivateTmp = true;
        PrivateDevices = true;
        ProtectSystem = "strict";
        ProtectHome = true;
        ProtectKernelTunables = true;
        ProtectKernelModules = true;
        ProtectControlGroups = true;
        RestrictAddressFamilies = [
          "AF_INET"
          "AF_INET6"
          "AF_UNIX"
        ];
        ReadWritePaths = [ dataDir cfg.storageDir cfg.backupDir ];
      };
    };

    networking.firewall.allowedTCPPorts = mkIf cfg.openFirewall [ cfg.port ];
  };
}
