# A NixOS module that runs taina as a plain systemd service from a release
# built in Nix, with no container runtime.
#
# Nothing is forced on the host. The database is a SQLite file the app owns:
# the module just points DATABASE_PATH at a directory it prepares (dbDir,
# under /var/lib/taina by default) and the app creates and migrates the file
# itself. No reverse proxy is configured either: the app binds bindIp:port and
# the host's proxy (caddy, cloudflared, ...) sits in front, or nothing does.
#
# Secrets live in an env file outside the store (SECRET_KEY_BASE). When the
# operator does not supply one, a first-boot oneshot generates it, the same way
# oka's install.sh writes a .env once.
#
# The app runs `Taina.Release.migrate` itself in ExecStartPre before the server
# starts, so updating is `nixos-rebuild switch` and a restart.
{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.services.taina;
  inherit (lib)
    mkIf
    mkOption
    mkEnableOption
    types
    optional
    boolToString
    escapeShellArg
    ;

  dataDir = "/var/lib/taina";

  # The env file the app reads. When the operator points at their own file, the
  # module never generates or touches it.
  envFile = if cfg.environmentFile != null then cfg.environmentFile else "${dataDir}/taina.env";

  # Generated on first boot only when the operator did not bring their own.
  generateSecrets = cfg.environmentFile == null;

  secretsScript = pkgs.writeShellScript "taina-secrets" ''
    set -eu
    env_file=${escapeShellArg envFile}
    if [ -e "$env_file" ]; then
      echo "taina: $env_file already exists, leaving it alone"
      exit 0
    fi
    secret="$(${pkgs.openssl}/bin/openssl rand -base64 48 | ${pkgs.coreutils}/bin/tr -d '\n')"
    umask 077
    ${pkgs.coreutils}/bin/mkdir -p ${escapeShellArg dataDir}
    ${pkgs.coreutils}/bin/cat > "$env_file" <<EOF
# Generated by the taina NixOS module on first boot. Keep it secret: it holds
# the session signing key. Rotating means deleting it and restarting.
SECRET_KEY_BASE=$secret
EOF
    ${pkgs.coreutils}/bin/chmod 600 "$env_file"
  '';

in
{
  options.services.taina = {
    enable = mkEnableOption "taina, the community private-cloud server";

    package = mkOption {
      type = types.package;
      default = pkgs.callPackage ./package.nix { };
      defaultText = lib.literalExpression "pkgs.callPackage ./package.nix { }";
      description = "The taina release to run.";
    };

    hostname = mkOption {
      type = types.str;
      example = "nuvem.example.org";
      description = ''
        Public hostname. Drives every URL taina builds (invites, links), so it
        must be the name people reach the box at, TLS included.
      '';
    };

    port = mkOption {
      type = types.port;
      default = 4000;
      description = "Port the process binds. Behind a proxy, this is the internal port.";
    };

    bindIp = mkOption {
      type = types.str;
      default = "127.0.0.1";
      description = ''
        Interface the HTTP listener binds. Loopback by default: a TLS proxy on
        the same box is the only thing that should reach it.
      '';
    };

    urlScheme = mkOption {
      type = types.enum [
        "http"
        "https"
      ];
      default = "https";
      description = ''
        Scheme the app puts in the URLs it builds (invites, links). https by
        default, the case behind a TLS proxy; http when nothing terminates TLS
        in front.
      '';
    };

    urlPort = mkOption {
      type = types.port;
      default = 443;
      description = "Port the app puts in the URLs it builds.";
    };

    environmentFile = mkOption {
      type = types.nullOr types.path;
      default = null;
      example = "/var/lib/taina/taina.env";
      description = ''
        File holding SECRET_KEY_BASE, mode 0600. Left null, the module
        generates one at /var/lib/taina/taina.env on first boot.
      '';
    };

    dbDir = mkOption {
      type = types.path;
      default = "${dataDir}/db";
      description = "Directory holding the SQLite database file (taina.db inside it).";
    };

    storageDir = mkOption {
      type = types.path;
      default = "${dataDir}/storage";
      description = "Directory holding Ybira uploads and renditions.";
    };

    backupDir = mkOption {
      type = types.path;
      default = "${dataDir}/backups";
      description = "Directory Nhaman writes scheduled backups to.";
    };

    backup = {
      enable = mkOption {
        type = types.bool;
        default = false;
        description = ''
          Turn on scheduled backups (a SQLite snapshot plus the storage archive)
          written into backupDir.
        '';
      };
    };

    updateCheck = mkOption {
      type = types.bool;
      default = false;
      description = ''
        Let the UI advertise newer taina releases. Off, the box makes no
        outbound call at all.
      '';
    };

    openFirewall = mkOption {
      type = types.bool;
      default = false;
      description = ''
        Open the port in the firewall. Off by default: a TLS proxy sits in
        front, so the only thing that should reach this port is the proxy on the
        loopback interface.
      '';
    };

    settings = mkOption {
      type = types.attrsOf types.str;
      default = { };
      example = { POOL_SIZE = "10"; };
      description = "Extra environment variables for the app, written verbatim.";
    };
  };

  config = mkIf cfg.enable {
    users.users.taina = {
      isSystemUser = true;
      group = "taina";
      home = dataDir;
      description = "taina community server";
    };
    users.groups.taina = { };

    systemd.tmpfiles.rules = [
      "d '${dataDir}' 0700 taina taina -"
      "d '${cfg.dbDir}' 0700 taina taina -"
      "d '${cfg.storageDir}' 0700 taina taina -"
      "d '${cfg.backupDir}' 0700 taina taina -"
    ];

    systemd.services.taina-secrets = mkIf generateSecrets {
      description = "taina: generate the environment file on first boot";
      wantedBy = [ "multi-user.target" ];
      before = [ "taina.service" ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        ExecStart = secretsScript;
        NoNewPrivileges = true;
      };
    };

    systemd.services.taina = {
      description = "taina community server";
      wantedBy = [ "multi-user.target" ];
      after = [ "network-online.target" ] ++ optional generateSecrets "taina-secrets.service";
      wants = [ "network-online.target" ];
      requires = optional generateSecrets "taina-secrets.service";
      # The data directories are often their own mount (a ZFS dataset); wait for
      # them rather than writing to the empty mountpoint on root.
      unitConfig.RequiresMountsFor = [
        cfg.dbDir
        cfg.storageDir
        cfg.backupDir
      ];

      environment =
        {
          PHX_SERVER = "true";
          PHX_HOST = cfg.hostname;
          PORT = toString cfg.port;
          BIND_IP = cfg.bindIp;
          PHX_URL_SCHEME = cfg.urlScheme;
          PHX_URL_PORT = toString cfg.urlPort;
          DATABASE_PATH = "${cfg.dbDir}/taina.db";
          STORAGE_ROOT = cfg.storageDir;
          BACKUP_ENABLED = boolToString cfg.backup.enable;
          BACKUP_DIR = cfg.backupDir;
          TAINA_UPDATE_CHECK = boolToString cfg.updateCheck;
        }
        // cfg.settings;

      serviceConfig = {
        Type = "exec";
        User = "taina";
        Group = "taina";
        WorkingDirectory = dataDir;
        EnvironmentFile = [ envFile ];
        # Migrations run before the server, the same order the release image
        # uses; they create and migrate the SQLite file on first boot.
        ExecStartPre = "${cfg.package}/bin/taina eval 'Taina.Release.migrate'";
        ExecStart = "${cfg.package}/bin/server";
        Restart = "on-failure";
        RestartSec = 5;
        # A clean SIGTERM lets the endpoint drain and in-flight work finish.
        KillSignal = "SIGTERM";
        TimeoutStopSec = 30;
        LimitNOFILE = 65536;

        # Hardening. MemoryDenyWriteExecute is left off: the BEAM's JIT needs
        # writable and executable memory.
        NoNewPrivileges = true;
        PrivateTmp = true;
        PrivateDevices = true;
        ProtectSystem = "strict";
        ProtectHome = true;
        ProtectKernelTunables = true;
        ProtectKernelModules = true;
        ProtectControlGroups = true;
        RestrictAddressFamilies = [
          "AF_INET"
          "AF_INET6"
          "AF_UNIX"
        ];
        ReadWritePaths = [
          cfg.dbDir
          cfg.storageDir
          cfg.backupDir
        ];
      };
    };

    networking.firewall.allowedTCPPorts = mkIf cfg.openFirewall [ cfg.port ];
  };
}
