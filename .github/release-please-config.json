{
  "bootstrap-sha": "fa1453f",
  "initial-version": "0.1.0",
  "bump-minor-pre-major": true,
  "separate-pull-requests": true,
  "pull-request-header": "Vamo mandar pra prod?",
  "pull-request-title-pattern": "chore: release${component} ${version}",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "feature",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": false
    },
    {
      "type": "style",
      "section": "Styles",
      "hidden": false
    },
    {
      "type": "chore",
      "section": "Miscellaneous Chores",
      "hidden": false
    },
    {
      "type": "refactor",
      "section": "Code Refactoring",
      "hidden": false
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": false
    },
    {
      "type": "build",
      "section": "Build System",
      "hidden": false
    },
    {
      "type": "ci",
      "section": "Continuous Integration",
      "hidden": false
    }
  ],
  "packages": {
    ".": {
      "release-type": "elixir",
      "include-component-in-tag": false,
      "exclude-paths": [
        "okena",
        "site"
      ],
      "extra-files": [
        {
          "type": "generic",
          "path": "flake.nix",
          "glob": false
        }
      ]
    },
    "okena": {
      "release-type": "simple",
      "component": "okena",
      "include-component-in-tag": true
    },
    "site": {
      "release-type": "simple",
      "component": "site",
      "include-component-in-tag": true
    }
  },
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json"
}
