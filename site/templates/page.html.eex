<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= @page_title %></title>
  <meta name="description" content="<%= @description %>" />
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content="#060A14" />
  <link rel="canonical" href="https://taina.dev.br<%= @canonical_url %>" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Tainá" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:title" content="<%= @page_title %>" />
  <meta property="og:description" content="<%= @description %>" />
  <meta property="og:url" content="https://taina.dev.br<%= @canonical_url %>" />
  <meta property="og:image" content="https://taina.dev.br/og.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Tainá: o cofre de arquivos e fotos de uma comunidade." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= @page_title %>" />
  <meta name="twitter:description" content="<%= @description %>" />
  <meta name="twitter:image" content="https://taina.dev.br/og.png" />
  <link rel="stylesheet" href="/styles/tokens.css" />
  <link rel="stylesheet" href="/styles/base.css" />
  <link rel="stylesheet" href="/styles/ybaka.css" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <script>
    document.documentElement.classList.add("js");
  </script>
</head>
<body>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

  <header class="site-header">
    <div class="shell site-header__inner">
      <a class="brand" href="/" aria-label="Tainá, início">
        <svg class="brand__mark" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2l2.2 7.8L22 12l-7.8 2.2L12 22l-2.2-7.8L2 12l7.8-2.2z" fill="currentColor" />
        </svg>
        <span class="brand__name">Tainá</span>
      </a>
      <nav class="site-nav site-nav--desktop" aria-label="Principal">
        <a class="site-nav__link" href="/" <%= if @current_path == "/", do: ~s(aria-current="page") %>>Início</a>
        <a class="site-nav__link" href="/demonstracao/" <%= if @current_path == "/demonstracao/", do: ~s(aria-current="page") %>>Como funciona</a>
        <a class="site-nav__link" href="/guias/" <%= if @current_path == "/guias/" or String.starts_with?(@current_path, "/guias/"), do: ~s(aria-current="page") %>>Guias</a>
        <a class="site-nav__link" href="/estado/" <%= if @current_path == "/estado/" or @current_path == "/evolucao/" or String.starts_with?(@current_path, "/estado/"), do: ~s(aria-current="page") %>>Estado</a>
        <a class="site-nav__link" href="/biblioteca/" <%= if @current_path == "/biblioteca/" or String.starts_with?(@current_path, "/biblioteca/"), do: ~s(aria-current="page") %>>Biblioteca</a>
      </nav>
      <details class="site-menu">
        <summary class="site-menu__trigger">Menu</summary>
        <nav class="site-nav site-nav--mobile" aria-label="Principal">
          <a class="site-nav__link" href="/" <%= if @current_path == "/", do: ~s(aria-current="page") %>>Início</a>
          <a class="site-nav__link" href="/demonstracao/" <%= if @current_path == "/demonstracao/", do: ~s(aria-current="page") %>>Como funciona</a>
          <a class="site-nav__link" href="/guias/" <%= if @current_path == "/guias/" or String.starts_with?(@current_path, "/guias/"), do: ~s(aria-current="page") %>>Guias</a>
          <a class="site-nav__link" href="/estado/" <%= if @current_path == "/estado/" or @current_path == "/evolucao/" or String.starts_with?(@current_path, "/estado/"), do: ~s(aria-current="page") %>>Estado</a>
          <a class="site-nav__link" href="/biblioteca/" <%= if @current_path == "/biblioteca/" or String.starts_with?(@current_path, "/biblioteca/"), do: ~s(aria-current="page") %>>Biblioteca</a>
        </nav>
      </details>
    </div>
  </header>

  <main id="conteudo" class="page-shell">
    <div class="shell">
      <%= if @document? do %>
        <%= @breadcrumbs_html %>
      <% end %>

      <%= if @notice do %>
        <aside class="page-notice<%= if @historical?, do: " page-notice--historical", else: " page-notice--current" %>" role="note">
          <p class="page-notice__text"><%= @notice %></p>
        </aside>
      <% end %>

      <div class="page-layout<%= if @document?, do: " page-layout--document", else: " page-layout--editorial" %>">
        <article class="prose page-content">
          <%= @content %>
        </article>

        <%= if @document? and @toc_html && @toc_html != "" do %>
          <aside class="page-toc">
            <nav class="page-toc__nav" aria-label="Nesta página">
              <h2 class="page-toc__title">Nesta página</h2>
              <div class="page-toc__content"><%= @toc_html %></div>
            </nav>
          </aside>
        <% end %>
      </div>

      <%= if @document? and @source_url do %>
        <aside class="document-source">
          <p class="document-source__text">Este documento faz parte da documentação do Tainá.</p>
          <a class="document-source__link" href="<%= @source_url %>">Fonte no GitHub (opcional para contribuir ou consultar o histórico)</a>
        </aside>
      <% end %>
    </div>
  </main>

  <footer class="site-footer">
    <div class="shell">
      <div class="site-footer__grid">
        <div class="site-footer__brand">
          <a class="brand" href="/">
            <svg class="brand__mark" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2l2.2 7.8L22 12l-7.8 2.2L12 22l-2.2-7.8L2 12l7.8-2.2z" fill="currentColor" />
            </svg>
            <span class="brand__name">Tainá</span>
          </a>
          <p>Arquivos e fotos guardados por uma comunidade, numa caixa que ela escolhe e cuida.</p>
        </div>
        <nav class="site-footer__col" aria-label="Estado e evolução">
          <h2>Estado e evolução</h2>
          <ul>
            <li><a href="/estado/">Estado atual</a></li>
            <li><a href="/estado/roadmap/">Roadmap do 1.0.0</a></li>
            <li><a href="/evolucao/">Evolução</a></li>
          </ul>
        </nav>
        <nav class="site-footer__col" aria-label="Informações">
          <h2>Informações</h2>
          <ul>
            <li><a href="/demonstracao/">Como funciona</a></li>
            <li><a href="/guias/">Guias</a></li>
            <li><a href="/biblioteca/">Biblioteca</a></li>
            <li><a href="/privacidade/">Privacidade</a></li>
            <li><a href="/transparencia/">Transparência</a></li>
            <li><a href="/glossario/">Glossário</a></li>
          </ul>
        </nav>
      </div>
      <div class="site-footer__legal">
        <span>Código sob GNU AGPL v3.0.</span>
        <span>Este site não usa cookies nem rastreamento.</span>
      </div>
    </div>
  </footer>

  <script src="/js/app.js"></script>
</body>
</html>
